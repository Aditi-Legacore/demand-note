datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  dob                DateTime?
  firstName          String?
  lastName           String?
  salutation         String?
  uniqueUserId       String?   @unique
  caseType           String?
  emailVerified      DateTime?
  image              String?
  status             Boolean   @default(false)

  roles              String[] @default([])
  createdById        String?
  forcePasswordReset Boolean   @default(false)
  requestPassword    Boolean   @default(false)
  isDeletedUser      Boolean   @default(false)

  uploadedFiles   DemandFile[]
  internalNotes   DemandInternalNote[]
  demandNotes     DemandNote[]
/* statusHistories DemandStatusHistory[] */
  formSubmissions FormSubmission[]
  intakes         IntakeInfo[]
  jobs            Job[]
  notes           Note[]
  // self-relation (already correct)
  createdBy    User?  @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[] @relation("CreatedUsers")

  notifications        Notification[]       @relation("UserNotifications")
  createdNotifications Notification[]       @relation("CreatedNotifications")
  demandNoteEditLocks  DemandNoteEditLock[]
}

