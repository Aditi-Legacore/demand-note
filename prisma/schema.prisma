model Note {
  id          String     @id @default(cuid())
  intakeId    String
  content     String
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User       @relation(fields: [createdById], references: [id])
  intake      IntakeInfo @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id               String     @id @default(uuid())
  intakeId         String
  activityType     String
  shortDescription String
  longDescription  String
  createdBy        String
  createdAt        DateTime   @default(now())
  intake           IntakeInfo @relation("IntakeToActivityLogs", fields: [intakeId], references: [id], onDelete: Cascade)
}

model OTP {
  id         String   @id @default(cuid())
  email      String
  otp        String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model DemandNote {
  id              String    @id @default(cuid())
  createdById     String
  title           String
  description     String?
  referenceNumber String?   @unique
  totalAmount     Float     @default(0)
  dueDate         DateTime?
  status          String    @default("draft")
  priority        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientName          String?
  salutation          String?
  firstName           String?
  middleName          String?
  lastName            String?
  defendantPhoneEmail String?

  // Defendant / insurance
  defendantName    String?
  claimNumber      String?
  insuranceName    String?
  adjuster         String?
  insuranceAddress String?
  phone            String?
  fax              String?
  claimType        String?
  additionalNotes  String?
  clientPhoneEmail String?

  // Relations
  files         DemandFile[]
  internalNotes DemandInternalNote[]
  notifications Notification[]
  editLocks     DemandNoteEditLock[]
  clients       DefedantClient[]
  createdBy     User                  @relation(fields: [createdById], references: [id])
  /* tags          DemandNoteTag[] */
  /* reminders     DemandReminder[] */
  /* statusHistory DemandStatusHistory[] */
  timeline      DemandTimeline[]
  jobs          Job?
}

model DefedantClient {
  id           String  @id @default(cuid())
  demandNoteId String?

  salutation String?
  firstName  String?
  middleName String?
  lastName   String?
  name       String
  email      String?
  phone      String?
  address    String?
  gstNumber  String?
  panNumber  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  demandNote DemandNote? @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
}


model DemandFile {
  id            String     @id @default(cuid())
  demandNoteId  String
  uploadedById  String
  fileName      String
  fileUrl       String
  fileType      String?
  size          Int?
  createdAt     DateTime   @default(now())
  fileCategory  String?
  status        String     @default("uploaded")
  filePath      String?
  summaryStatus String     @default("not_summarized")
  demandNote    DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  uploadedBy    User       @relation(fields: [uploadedById], references: [id])
  tasks         Task[]
}

model Job {
  id              String     @id @default(cuid())
  demandNoteId    String     @unique
  createdById     String
  status          String     @default("pending")
  numTasks        Int        @default(0)
  createTs        DateTime   @default(now())
  updateTs        DateTime   @updatedAt
  combinedSummary String?
  publishStatus   String     @default("draft")
  createdBy       User       @relation(fields: [createdById], references: [id])
  demandNote      DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  tasks           Task[]
}

model Task {
  id              String     @id @default(cuid())
  jobId           String
  fileName        String
  filePath        String
  status          String     @default("pending")
  pid             Int?
  startTs         DateTime?
  endTs           DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  outputSummary   String?
  demandFileId    String
  outputFilePath  String?
  editedSummary   String?
  editedSummaryTs DateTime?
  demandFile      DemandFile @relation(fields: [demandFileId], references: [id])
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model DemandInternalNote {
  id           String     @id @default(cuid())
  demandNoteId String
  createdById  String
  content      String
  createdAt    DateTime   @default(now())
  createdBy    User       @relation(fields: [createdById], references: [id])
  demandNote   DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
}

model DemandTimeline {
  id           String     @id @default(cuid())
  demandNoteId String
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime   @default(now())
  demandNote   DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
}


model DemandNoteEditLock {
  id           String     @id @default(cuid())
  demandNoteId String
  userId       String
  userName     String
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  demandNote   DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demandNoteId, userId])
  @@index([demandNoteId, updatedAt])
}

