model Lead {
  id             String      @id @default(cuid())
  dueDate        DateTime
  name           String
  caseType       String
  status         String      @default("new")
  contact        String
  phone          String
  matter         String      @default("-")
  description    String?
  referralSource String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  dateOfBirth    DateTime?
  email          String
  referenceId    String?     @unique
  intakeInfo     IntakeInfo?
}

model Document {
  id         String     @id @default(cuid())
  intakeId   String
  fileName   String
  filePath   String
  mimeType   String?
  uploadedAt DateTime   @default(now())
  intake     IntakeInfo @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}
